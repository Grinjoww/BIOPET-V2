digraph G {
  graph [rankdir=TB, dpi=200, bgcolor="white", fontname="Arial", label="BIOPET - C4 Nivel 1: Contexto (v0.9.0-rc)", labelloc=t, fontsize=22];
  node [shape=box, style="rounded,filled", fillcolor="#F8FAFC", color="#0F766E", fontname="Arial", fontsize=12];
  edge [fontname="Arial", fontsize=10, color="#334155"];

  vet [label="Veterinario\n[Persona]\nRegistra y gestiona mascotas.\n(Historial clinico: pendiente)", shape=oval, fillcolor="#ECFEFF"];
  admin [label="Administrador\n[Persona]\nGestiona mascotas y ve\nel resumen global por especie.", shape=oval, fillcolor="#ECFEFF"];
  auxiliar [label="Auxiliar\n[Persona]\nGestiona mascotas.", shape=oval, fillcolor="#ECFEFF"];
  dueno [label="Dueño de Mascota\n[Persona]\nConsulta unicamente\nsus propias mascotas.", shape=oval, fillcolor="#ECFEFF"];

  biopet [label="BIOPET\n[Sistema de software]\nCentraliza el registro de\nmascotas y su gestion\npor rol (RBAC + JWT).", fillcolor="#DBEAFE", fontsize=14, width=3, height=1.3];

  subgraph cluster_pendiente {
    label="Sistemas externos planificados (vision Entrega 1A) — NO implementados en v0.9.0-rc";
    style="dashed";
    color="#94A3B8";
    fontname="Arial";
    fontsize=11;
    fontcolor="#64748B";
    node [style="rounded,dashed", fillcolor="#F1F5F9", color="#94A3B8", fontcolor="#64748B"];
    iot [label="Dispositivos IoT\n[Sistema externo]\nTelemetria de ubicacion\n(REQ-F-016, pendiente)"];
    ia [label="Servicio de IA Cognitiva\n[Sistema externo]\nRecomendaciones clinicas\n(REQ-F-017, pendiente)"];
    correo [label="Servicio de Correos\n[Sistema externo]\nNotificaciones\n(sin requisito formal aun)"];
  }

  vet -> biopet [label="usa\n[HTTPS]"];
  admin -> biopet [label="usa\n[HTTPS]"];
  auxiliar -> biopet [label="usa\n[HTTPS]"];
  dueno -> biopet [label="usa\n[HTTPS]"];

  biopet -> iot [label="recibiria telemetria de\n[API REST]", style=dashed, color="#94A3B8", fontcolor="#64748B"];
  biopet -> ia [label="consultaria recomendaciones\n[HTTPS/JSON]", style=dashed, color="#94A3B8", fontcolor="#64748B"];
  biopet -> correo [label="enviaria notificaciones\n[SMTP/API]", style=dashed, color="#94A3B8", fontcolor="#64748B"];
}
