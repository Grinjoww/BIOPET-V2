  title        = {Architectural Styles and the Design of Network-based Software Architectures},
  school       = {University of California, Irvine},
  year         = {2000},
  type         = {Doctoral dissertation},
  howpublished = {\url{https://www.ics.uci.edu/~fielding/pubs/dissertation/top.htm}},
  note         = {Fuente primaria del estilo arquitectonico REST (capitulo 5 de la disertacion); no se inventa DOI, la disertacion no tiene uno asignado.}
}

