# version: versión objetivo de la Entrega Final. El tag "v1.0.0" todavia
# NO ha sido publicado en este repositorio (verificar con "git tag
# --list"); este campo declara la version de software que se citara una
# vez publicado ese tag, no una release ya existente.
version: 1.0.0
# date-released: deliberadamente SIN valor todavia. No se fija una fecha
# de release real hasta que el tag "v1.0.0" exista y quede publicado; fijar
# una fecha ahora implicaria afirmar un release que no ha ocurrido.
license: MIT
