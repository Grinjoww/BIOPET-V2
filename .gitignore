# Java
Backend/target/
*.class
*.jar
# Node
frontend/node_modules/
frontend/dist/
# Cache local de Angular CLI/Vite (se regenera solo con "ng serve"/"ng build"/"ng test";
# no es código fuente ni configuración - nunca debe versionarse). Ver sección
# "ACCIONES MANUALES" del informe de higiene: hay ~27 archivos de este directorio
# ya trackeados de antes que esta regla no destrackea por sí sola.
frontend/.angular/
# Salida de "ng test --code-coverage" (HTML/lcov generados, se regenera en cada
# corrida de la suite; no aporta nada versionado).
frontend/coverage/
# Env
.env
*.log
# Postman: entorno local con valores reales (la plantilla sin secretos si se versiona)
docs/postman/*.local.postman_environment.json
# Certificados de desarrollo local (HTTPS/TLS BIOPET) - nunca versionar el keystore real
Backend/certs/*
!Backend/certs/.gitkeep
# IDE
.idea/
.vscode/
*.iml
# Claude Code: archivos de estado/local del propio asistente, no del producto.
# .claude/skills/ (p. ej. biopet-ui/SKILL.md) SÍ debe versionarse -es guía de
# proyecto real-, por eso no se ignora ".claude/" completo, solo estos dos.
.claude/settings.local.json
.claude/scheduled_tasks.lock
# OS
.DS_Store
Thumbs.db
cookies.txt

# Salida cruda de lhci autorun (se archiva ya procesada en docs/mediciones/lighthouse/)
.lighthouseci/
.lighthouseci-desktop/
