# =========================================================
# BIOPET — Variables de entorno
# Secciones: DESARROLLO (docker-compose.yml) y PRODUCCION
# (Render: render.yaml | VPS: docker-compose.prod.yml).
# Copiar como .env y completar los valores reales.
# NINGUN valor aqui es un secreto real; en produccion los
# secretos se definen en el proveedor (dashboard/secretos).
# =========================================================

# =========================================================
# DESARROLLO LOCAL (docker-compose.yml)
# =========================================================

# --- Base de datos (PostgreSQL) ---
DB_NAME=biopet_db
DB_USER=biopet_user
DB_PASSWORD=biopet_pass
# URL JDBC local: "postgres" es el nombre del servicio en docker-compose.yml.
DB_URL=jdbc:postgresql://postgres:5432/biopet_db

# --- Autenticacion JWT (solo desarrollo) ---
JWT_SECRET=9c8f9a7d6e5b4c3a2d1f0e9c8b7a6d5e4f3a2b1c0d9e8f7a6b5c4d3e2f1a0b9c
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000
JWT_ISSUER=biopet-api
JWT_AUDIENCE=biopet-frontend

# --- Cache (Redis) ---
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_TTL_MS=300000

# --- CORS (frontend Angular de desarrollo) ---
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Cuenta de aplicacion (privilegios minimos, usada por Hibernate en runtime) ---
# Debe coincidir con la contrasena creada en db/roles.sql.
DB_APP_USER=biopet_app
DB_APP_PASSWORD=biopet_app_dev_pass

# --- Bootstrap del ADMIN semilla (B-1) ---
# DataInitializer (CommandLineRunner "seedAdmin") ya NO crea ninguna cuenta
# por defecto: sin ADMIN_SEED_ENABLED=true no se siembra ningun ADMIN.
# Estas 4 variables son EXCLUSIVAMENTE de desarrollo local: la contrasena de
# abajo es un dato ficticio, publico, documentado tambien en db/seed.sql,
# README.md y docs/etica/ETHICS.md -no representa un secreto real y NUNCA
# debe reutilizarse en produccion. En produccion (Render) se definen las
# mismas 3 variables una unica vez, con un email/password reales controlados
# por el operador (ver docs/despliegue/DEPLOYMENT.md), y ADMIN_SEED_ENABLED
# se puede volver a poner en false una vez creada la cuenta.
ADMIN_SEED_ENABLED=true
ADMIN_SEED_EMAIL=admin@biopet.ec
ADMIN_SEED_PASSWORD=Admin123*
ADMIN_SEED_NAME=Administrador BIOPET

# --- Clave de la API externa (Animal API Ninjas) ---
# Solo desarrollo. En produccion se define en el proveedor, NO en este archivo.
APP_EXTERNAL_API_KEY=

# =========================================================
# PRODUCCION (Render: render.yaml)
# Los valores marcados sync:false en render.yaml se completan
# en el dashboard de Render (Secret Files / Environment):
#   JWT_SECRET, CORS_ALLOWED_ORIGINS
# Render enlaza automaticamente (fromDatabase/fromService):
#   DB_HOST, DB_PORT, DB_NAME, DB_USER, DB_PASSWORD,
#   DB_APP_USER, DB_APP_PASSWORD, REDIS_HOST, REDIS_PORT
# =========================================================

# =========================================================
# PRODUCCION ALTERNATIVA (VPS con docker-compose.prod.yml)
# Las variables de produccion NO se asignan aqui: este archivo
# se copia como .env tambien en desarrollo (scripts/run-zap-baseline.sh)
# y un valor vacio pisaria los valores de desarrollo (docker-compose.yml
# usa env_file: .env; en un env_file la ULTIMA asignacion gana).
# El operador crea un .env propio para produccion con estos valores
# (ver docs/despliegue/DEPLOYMENT.md):
# =========================================================

# Dominio publico apuntando al VPS (Caddy emite HTTPS Let's Encrypt).
# DOMAIN=

# JWT: secreto HMAC fuerte, generado por el operador
# (ej. openssl rand -base64 48) y rotado periodicamente (ver RUNBOOK.md).
# JWT_SECRET=

# Base de datos de produccion
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# DB_APP_USER=
# DB_APP_PASSWORD=

# Clave real de la API externa (nunca commitear)
# APP_EXTERNAL_API_KEY=