# =========================================================
# BIOPET — Variables de entorno para desarrollo local
# Copiar este archivo como .env y ajustar solo si es necesario.
# NINGÚN valor aquí es un secreto real; son valores de desarrollo.
# =========================================================

# --- Base de datos (PostgreSQL) ---
# Nombre de la base, usuario y contraseña que usará el contenedor
# de Postgres al inicializarse, y que la app usa para conectarse.
DB_NAME=biopet_db
DB_USER=biopet_user
DB_PASSWORD=biopet_pass
# URL JDBC que usa Spring Boot. "postgres" es el nombre del servicio
# en docker-compose.yml, no un host externo.
DB_URL=jdbc:postgresql://postgres:5432/biopet_db

# --- Autenticación JWT ---
# Clave HMAC de ejemplo para firmar los tokens. Es un valor de
# desarrollo, no debe reutilizarse en un entorno real de producción.
JWT_SECRET=9c8f9a7d6e5b4c3a2d1f0e9c8b7a6d5e4f3a2b1c0d9e8f7a6b5c4d3e2f1a0b9c
# Duración del access token, en milisegundos (aquí: 1 hora).
JWT_EXPIRATION_MS=3600000
# Duración del refresh token, en milisegundos (aquí: 7 días).
JWT_REFRESH_EXPIRATION_MS=604800000
# Emisor que identifica al backend que genera los tokens JWT.
JWT_ISSUER=biopet-api

# Audiencia autorizada para consumir los tokens JWT.
JWT_AUDIENCE=biopet-frontend

# --- Cache (Redis) ---
# Host y puerto del servicio Redis definido en docker-compose.yml.
REDIS_HOST=redis
REDIS_PORT=6379
# TTL de las entradas de cache Redis (Spring Cache), en milisegundos.
# Pasado este tiempo, una entrada cacheada expira automaticamente
# aunque no haya habido un CacheEvict explicito (crear/actualizar/eliminar).
CACHE_TTL_MS=300000

# --- CORS ---
# Origen permitido para las peticiones del frontend Angular en desarrollo.
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Cuenta de aplicacion (privilegios minimos, usada por Hibernate en runtime) ---
# Debe coincidir exactamente con la contraseña creada en db/roles.sql,
# ya que ese script no puede leer variables de entorno de Spring Boot.
DB_APP_USER=biopet_app
DB_APP_PASSWORD=biopet_app_dev_pass